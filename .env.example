# Токен бота из @BotFather
TELEGRAM_BOT_TOKEN=

# Прокси для Telegram, если он недоступен напрямую:
#   http://127.0.0.1:10809   или   socks5://127.0.0.1:1080
# При включённом системном VPN оставьте пустым.
TELEGRAM_PROXY=

# Ключ DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Можно не менять
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Куда складывать историю диалогов
DB_PATH=./data/bot.db
