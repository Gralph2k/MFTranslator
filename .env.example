# Токен бота из @BotFather
TELEGRAM_BOT_TOKEN=

# Прокси для Telegram, если он недоступен напрямую:
#   http://127.0.0.1:10809   или   socks5://127.0.0.1:1080
# При включённом системном VPN оставьте пустым.
TELEGRAM_PROXY=

# Ключ DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Можно не менять
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Куда складывать историю диалогов
DB_PATH=./data/bot.db

# Vision-модель для «Проверки анкеты» (оценка фото): любой OpenAI-совместимый
# endpoint. На проде — Z.AI glm-4.6v; альтернатива — OpenRouter.
# Регистрация и цены: deploy/OPENROUTER.md. Пусто = фаза фото отключена.
VISION_API_KEY=
VISION_BASE_URL=https://openrouter.ai/api/v1
VISION_MODEL=google/gemini-2.5-flash-lite

# Отладочный дублик «Проверки анкеты» (время тестирования).
# Основной канал — Telegram: PROFILE_DEBUG_CHAT_ID = telegram_id владельца.
# Выключить = очистить переменную и перезапустить бота.
PROFILE_DEBUG_CHAT_ID=

# Дублик почтой — НЕ РАБОТАЕТ на текущем VPS: хостер блокирует исходящие
# SMTP-порты (465/587). Оставлено на случай переезда; включается заполнением
# всех четырёх значений + PROFILE_DEBUG_EMAIL.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
PROFILE_DEBUG_EMAIL=
